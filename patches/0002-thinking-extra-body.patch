+def _choice_text(choice):
+    """Final answer text. Reasoning parsers may empty content."""
+    msg = choice.message
+    content = getattr(msg, "content", None) or ""
+    if isinstance(content, list):
+        parts = []
+        for p in content:
+            if isinstance(p, dict):
+                parts.append(p.get("text") or "")
+            else:
+                parts.append(getattr(p, "text", None) or "")
+        content = "".join(parts)
+    if str(content).strip():
+        return content
+    return getattr(msg, "reasoning_content", None) or ""
+
+
+_GEMMA_CHANNEL_RE = re.compile(
+    r"<\|channel>thought\s*.*?<channel\|>",
+    flags=re.DOTALL | re.IGNORECASE,
+)
+_MUSE_SELF_RE = re.compile(
+    r"to=self(?:<\|message\|>)?.*?<\|eom\|>",
+    flags=re.DOTALL | re.IGNORECASE,
+)
+
+
+def _strip_think_blocks(text):
+    """Drop Qwen / Gemma / Muse thinking so sketch fences inside cannot win.
+
+    Qwen: <think>...</think>, or a bare </think> (everything before is thinking).
+    Gemma 4: <|channel>thought ... <channel|>, including the empty channel
+    31B still emits when thinking is off.
+    Muse Glimmer: to=self ... <|eom|> (always-on reasoning channel).
+    """
+    text = _GEMMA_CHANNEL_RE.sub("", text)
+    text = _MUSE_SELF_RE.sub("", text)
+    text = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL | re.IGNORECASE)
+    if re.search(r"</think>", text, flags=re.IGNORECASE):
+        text = re.split(r"</think>", text, maxsplit=1, flags=re.IGNORECASE)[-1]
+    return text
+
+
+def _has_unclosed_muse(text):
+    """True when a Muse to=self reasoning turn is still open."""
+    rest = _MUSE_SELF_RE.sub("", text)
+    return bool(re.search(r"to=self", rest, re.I))
+
+
+def _has_unclosed_think(text):
+    """True when a think/channel opener is still open (truncated mid-think)."""
+    rest = _GEMMA_CHANNEL_RE.sub("", text)
+    rest = re.sub(r"<think>.*?</think>", "", rest, flags=re.DOTALL | re.IGNORECASE)
+    if re.search(r"<think>", rest, re.I):
+        return True
+    if re.search(r"<\|channel>thought", rest, re.I):
+        return True
+    return False
+
