index 7d97eff..40818e7 100644
--- a/src/kernelbench/kernel_static_checker.py
+++ b/src/kernelbench/kernel_static_checker.py
@@ -275,6 +275,72 @@ def check_cute_impl(code: str) -> Tuple[bool, str]:
     return (False, "")
 
 
+# <========= CUTILE CHECKS =========>
+# Rationale: cuTile kernels are Python functions marked with @ct.kernel and are
+# dispatched from the host with ct.launch(). Because a cuTile "kernel" is plain
+# Python, a model can emit a ModelNew that passes correctness while calling only
+# torch ops, so requiring the decorator, the launch and actual tile ops is what
+# distinguishes a real cuTile implementation from a PyTorch passthrough.
+# https://docs.nvidia.com/cuda/cutile-python
+CUTILE_IMPORT_PATTERN = r"(?:import\s+cuda\.tile(?:\s+as\s+(\w+))?|from\s+cuda\s+import\s+tile(?:\s+as\s+(\w+))?)"
+
+# Tile ops that constitute real kernel work, as opposed to merely importing the
+# module. Mirrors the tl.* requirement used for Triton.
+CUTILE_OPS = (
+    "load", "store", "mma", "matmul", "mma_scaled", "gather", "scatter",
+    "sum", "max", "min", "prod", "reduce", "scan", "cumsum", "cumprod",
+    "zeros", "ones", "full", "arange", "where", "transpose", "permute",
+    "reshape", "broadcast_to", "astype", "exp", "log", "sqrt", "rsqrt",
+    "maximum", "minimum", "argmax", "argmin", "atomic_add", "cat",
+    "expand_dims", "tanh", "abs", "bid", "num_blocks", "num_tiles",
+)
+
+
+def _cutile_aliases(code: str) -> List[str]:
+    """Collect the names cuda.tile is bound to (default alias plus any 'as X')."""
+    aliases = []
+    for m in re.finditer(CUTILE_IMPORT_PATTERN, code):
+        alias = m.group(1) or m.group(2)
+        if alias:
+            aliases.append(alias)
+        else:
+            # Bare "import cuda.tile" is referenced as cuda.tile.*;
+            # bare "from cuda import tile" is referenced as tile.*
+            aliases.append("cuda.tile" if m.group(0).startswith("import") else "tile")
+    return aliases
+
+
+def check_cutile_impl(code: str) -> Tuple[bool, str]:
+    """
+    Check for valid cuTile kernel implementation.
+
+    Requirements:
+    - Must import cuda.tile
+    - Must have an @<alias>.kernel decorated function (kernel definition)
+    - Must call <alias>.launch(...) (kernel is actually dispatched, not dead code)
+    - Must use tile operations (enforces real kernel body, not a torch wrapper)
+    """
+    code = _strip_comments(code)
+
+    aliases = _cutile_aliases(code)
+    if not aliases:
+        return (True, "Missing 'import cuda.tile' (no cuTile import found)")
+
+    alias_group = "|".join(re.escape(a) for a in set(aliases))
+
+    if not re.search(rf"@(?:{alias_group})\.kernel\b", code):
+        return (True, "Missing @ct.kernel decorated kernel definition")
+
+    if not re.search(rf"\b(?:{alias_group})\.launch\s*\(", code):
+        return (True, "Missing ct.launch(...) call (kernel is never dispatched)")
+
+    ops_group = "|".join(CUTILE_OPS)
+    if not re.search(rf"\b(?:{alias_group})\.(?:{ops_group})\b", code):
+        return (True, "No cuTile tile operations found in kernel")
+
+    return (False, "")
+
+
 # <========= TILELANG CHECKS =========>
 # TileLang uses TVM's T.prim_func decorator
 # https://github.com/tile-ai/tilelang
@@ -582,6 +648,7 @@ CHECK_FUNCTIONS: Dict[str, Union[Callable[[str], Tuple[bool, str]], Callable[[st
     "triton_impl": check_triton_impl,
     "tk_impl": check_tk_impl,
     "cute_impl": check_cute_impl,
+    "cutile_impl": check_cutile_impl,
     "tilelang_impl": check_tilelang_impl,
 }
 
