+def extract_best_code(output_string: str, code_language_types: list[str]) -> str | None:
+    """
+    Extract the code block that is most likely to be the model's answer.
+
+    extract_first_code() takes the literal first fenced block regardless of its
+    language tag. Models frequently open with an untagged block holding a formula
+    or a shape sketch ("y = (x - mean) / sqrt(var + eps)"), and that prose then
+    gets evaluated as the kernel. This picks by content instead:
+
+      1. the last block defining ModelNew (models often revise, so prefer the last)
+      2. otherwise the last block tagged with a requested language
+      3. otherwise the longest block
+
+    Returns None when there is no fenced block at all.
+    """
+    if output_string is None:
+        return None
+
+    blocks = re.findall(r"```(\w*)\n?(.*?)```", output_string.strip(), re.DOTALL)
+    if not blocks:
+        return None
+
+    def clean(lang: str, body: str) -> str:
+        body = body.strip()
+        # Handle ```python foo``` written on one line, where the tag lands in the body.
+        for code_type in code_language_types:
+            if body.startswith(code_type):
+                body = body[len(code_type):].strip()
+        return body
+
+    cleaned = [(lang.lower(), clean(lang, body)) for lang, body in blocks]
+
+    defines_model = [c for _, c in cleaned if re.search(r"class\s+ModelNew\b", c)]
+    if defines_model:
+        return defines_model[-1]
+
+    tagged = [c for lang, c in cleaned if lang in code_language_types]
+    if tagged:
+        return tagged[-1]
+
+    return max((c for _, c in cleaned), key=len)
+
+
