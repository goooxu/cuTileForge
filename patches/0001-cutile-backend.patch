+def enforce_reference_precision():
+    """Force torch fp32 matmul/conv to be true fp32 rather than TF32.
+
+    Correctness is judged by allclose(reference, generated) at atol=rtol=1e-4 for
+    fp32. Some environments (notably the NGC PyTorch containers) default to
+    allow_tf32=True, which puts ~2e-2 of error into the *reference* side and
+    fails generated kernels that are numerically more accurate than torch.
+    Pinning true fp32 restores upstream PyTorch defaults so both sides agree.
+    """
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.set_float32_matmul_precision("highest")
+
