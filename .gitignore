# Upstream KernelBench checkout, rebuilt by scripts/setup_kernelbench.sh
/kernelbench/

# Model weights (hundreds of GB)
/models/

# Run artifacts. These are regenerable output, not source: 1600 generated
# kernels, the raw model responses, and per-sample eval results run ~33 MB per
# evaluation, and this project iterates eval -> train -> eval. Only the summary
# artifacts needed to check the report are committed, under results/.
/runs/

# Intermediate output of results/report/make_charts.py; the figures it holds are
# inlined into index.html by refresh_charts.py.
/results/report/charts.html

__pycache__/
*.py[cod]
.venv/
*.egg-info/
.env

# Core dumps from the cuTile compiler. A generated kernel that segfaults
# tileiras drops one of these in the working directory, and they are hundreds
# of megabytes each.
core.*
